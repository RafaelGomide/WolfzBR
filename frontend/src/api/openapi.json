              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Projeto"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Abrir Projeto"
      }
    },
    "/api/projects/{project_id}/exports": {
      "post": {
        "description": "Gera os arquivos. Pasta com arquivo do mesmo nome: falha, a não ser\ncom ``overwrite`` (F0.A6). Tudo é gerado numa pasta temporária e movido\nno fim (build-then-swap, F1.I4).",
        "operationId": "exportar_api_projects__project_id__exports_post",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoExportacao"
              }
            }
          },
          "required": true
        },
