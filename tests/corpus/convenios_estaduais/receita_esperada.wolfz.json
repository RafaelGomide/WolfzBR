{
  "created_at": "2026-10-16T00:00:00Z",
  "name": "convenios estaduais",
  "source": {
    "type": "csv"
  },
  "steps": [
    {
      "end_detect": "auto",
      "id": "s1",
      "op": "select_range",
      "start": "A4"
    },
    {
      "id": "s2",
      "n": 1,
      "op": "header_rows"
    },
    {
      "col": "Nº Convênio",
      "id": "s3",
      "match": "equals",
      "op": "drop_rows_where",
      "value": "Total"
    },
    {
      "id": "s4",
      "mapping": {
        "Contrapartida (R$)": "contrapartida",
        "Data de assinatura": "data_assinatura",
        "Município": "municipio",
        "Nº Convênio": "numero_convenio",
        "Objeto": "objeto",
        "Valor (R$)": "valor"
      },
      "op": "rename"
    },
    {
      "cols": [
        "valor",
        "contrapartida"
      ],
      "id": "s5",
      "op": "parse_brl"
    },
    {
      "cols": [
        "data_assinatura"
      ],
      "id": "s6",
      "op": "parse_date_br"
    }
  ],
  "wolfz_version": "1.0"
}
