{
  "created_at": "2026-10-16T00:00:00Z",
  "name": "verificações aprovadas",
  "source": {
    "type": "csv"
  },
  "steps": [
    {
      "cols": [
        "Nome da Rua",
        "Numero Rua",
        "Complemento",
        "Bairro",
        "Cep"
      ],
      "id": "s1",
      "op": "drop_cols"
    },
    {
      "id": "s2",
      "mapping": {
        "Bandeira": "bandeira",
        "CNPJ da Revenda": "cnpj",
        "Data da Coleta": "data_coleta",
        "Estado - Sigla": "uf",
        "Municipio": "municipio",
        "Produto": "produto",
        "Regiao - Sigla": "regiao",
        "Revenda": "revenda",
        "Unidade de Medida": "unidade",
        "Valor de Compra": "valor_compra",
        "Valor de Venda": "valor_venda"
      },
      "op": "rename"
    },
    {
      "cols": [
        "cnpj"
      ],
      "add_valid_col": false,
      "id": "s3",
      "op": "clean_cnpj",
      "pad_zeros": true
    },
    {
      "accept_excel_serial": true,
      "century_pivot": 30,
      "cols": [
        "data_coleta"
      ],
      "eight_digits": "auto",
      "id": "s4",
      "op": "parse_date_br"
    },
    {
      "cols": [
        "valor_venda",
        "valor_compra"
      ],
      "dash_is_zero": false,
      "debit_negative": false,
      "decimal": ",",
      "id": "s5",
      "op": "parse_decimal_br"
    },
    {
      "check": "not_null",
      "cols": [
        "cnpj",
        "data_coleta",
        "valor_venda"
      ],
      "id": "s6",
      "op": "assert"
    },
    {
      "check": "in_range",
      "cols": [
        "valor_venda"
      ],
      "id": "s7",
      "max": 200.0,
      "min": 50.0,
      "op": "assert"
    },
    {
      "check": "in_range",
      "cols": [
        "data_coleta"
      ],
      "id": "s8",
      "max": "2024-12-31",
      "min": "2024-07-01",
      "op": "assert"
    },
    {
      "check": "matches",
      "cols": [
        "uf"
      ],
      "id": "s9",
      "op": "assert",
      "pattern": "^[A-Z]{2}$"
    },
    {
      "check": "row_count_min",
      "cols": [],
      "id": "s10",
      "min_rows": 1000,
      "op": "assert"
    }
  ],
  "wolfz_version": "1.0"
}
